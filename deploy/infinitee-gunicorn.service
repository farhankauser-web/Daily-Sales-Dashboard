[Unit]
Description=Infinitee Dashboard (gunicorn WSGI)
After=network.target postgresql.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Daily-Sales-Dashboard
EnvironmentFile=/home/ubuntu/Daily-Sales-Dashboard/.env
# 2 workers keeps memory sane on the 900MB box (each ~120MB). Bind to
# localhost only — nginx (or the upstream TLS proxy) fronts it on 443/80.
ExecStart=/home/ubuntu/Daily-Sales-Dashboard/venv/bin/gunicorn infinitee.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --threads 2 \
    --timeout 120 \
    --access-logfile /home/ubuntu/Daily-Sales-Dashboard/logs/gunicorn-access.log \
    --error-logfile  /home/ubuntu/Daily-Sales-Dashboard/logs/gunicorn-error.log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
