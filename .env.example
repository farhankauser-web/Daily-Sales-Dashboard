# ─────────────────────────────────────────────────────────────
#  Infinitee Xclusives — Environment Configuration
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Django Core
DJANGO_SECRET_KEY=replace-with-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# Database
# Leave DATABASE_URL unset to use the local SQLite file (zero-config dev).
# On EC2/production, set it to a Postgres DSN and install psycopg2-binary:
#   DATABASE_URL=postgres://infinitee_user:strong-password@127.0.0.1:5432/infinitee?sslmode=require
# Optional: DB_CONN_MAX_AGE (seconds a connection is reused; default 60).
# DATABASE_URL=
# DB_CONN_MAX_AGE=60

# Fernet Encryption Key (for API credentials at rest)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-base64-encoded-fernet-key=

# Anthropic (fallback if not stored in DB)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
